// CollegeSplit Prisma schema
// See CONTEXT.md for the canonical domain vocabulary.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A person who has installed CollegeSplit and signed in via Google.
// The User's id is their Firebase UID.
enum SplitMethod {
  Equal
  Ratio
  Adhoc
}

enum Category {
  FoodDrink
  Transport
  Groceries
  RentUtilities
  Travel
  Entertainment
  Other
}

model User {
  id          String   @id
  displayName String
  email       String   @unique
  // Optional, private to the User. Never displayed to other Users.
  // Used only as an exact-matching key for Share (see CONTEXT.md).
  phoneNumber String?
  createdAt   DateTime @default(now())
  expenses    Expense[]
  contacts    Contact[]
}

// A single spend event entered by a User (the ledger owner), with an amount
// (in INR, stored as integer paise), a Category, a Payer, and zero or more
// Participants who share its cost. The Expense belongs to the private Ledger
// of the owning User; Ledgers are never shared or synced between Users.
//
// Balance is never stored — it is always recomputed from the Participants'
// per-expense shares (see the LedgerService).
model Expense {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int // total spend in paise (1 INR = 100 paise)
  category    Category
  // Who fronted the money. Defaults to the owning User, but may be any person.
  payerName   String
  // Whether the Payer is the owning User (drives the direction of Balances).
  isUserPayer Boolean       @default(true)
  splitMethod SplitMethod
  createdAt   DateTime      @default(now())
  participants Participant[]
}

// A person named on a single Expense as sharing its cost. In ticket 02
// Participants are free-text names only (no Contact matching yet — ticket 05),
// so `name` is the identity key used for per-counterparty Balance aggregation.
// `sharePaise` is the computed amount this Participant owes the Payer.
// `isUser` marks when the Participant is the ledger's owning User (used when a
// non-User Payer fronts money the User shares in).
model Participant {
  id         String  @id @default(cuid())
  expenseId  String
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name       String
  sharePaise Int // in paise; only meaningful when isUser is false
  isUser     Boolean @default(false)
}

// A person a User has split an Expense with more than once, remembered for
// reuse across future Expenses. Accumulates automatically — no explicit setup.
// Each Contact belongs to exactly one User's own list; lists are never shared
// or merged between Users. A phone number is the optional identity anchor that
// makes the Contact eligible for name-based local matching (ticket 05); without
// one the Contact is name-only and intended to stay ephemeral.
model Contact {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  // Optional private phone number, editable by the User. The anchor for
  // recognizing the same person across this User's Expenses.
  phoneNumber   String?
  // Ticket 11 fills this in when the Contact is resolved to a registered User
  // by exact phone match. This ticket only carries the field.
  resolvedUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@unique([userId, name])
}
